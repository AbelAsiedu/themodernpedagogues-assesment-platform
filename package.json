{
  "name": "tmp-assessment-platform",
  "private": true,
  "version": "0.1.0",
  "description": "The Modern Pedagogues (TMP) — AI-powered assessment & examination platform",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @tmp/api dev",
    "dev:web": "pnpm --filter @tmp/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @tmp/api db:generate",
    "db:migrate": "pnpm --filter @tmp/api db:migrate",
    "db:seed": "pnpm --filter @tmp/api db:seed"
  }
}
