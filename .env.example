# Copy to apps/api/.env for local development. NEVER commit real values.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

NODE_ENV=development
PORT=4000

# PostgreSQL (managed instance in production)
DATABASE_URL=postgres://tmp:tmp_dev_password@localhost:5432/tmp_assessment
TEST_DATABASE_URL=postgres://tmp:tmp_dev_password@localhost:5432/tmp_assessment_test

# Redis (rate limiting now; live-quiz leaderboards and job queues in later phases)
REDIS_URL=redis://localhost:6379

# Browser origin(s) allowed to call the API, comma separated
WEB_ORIGINS=http://localhost:3000

# Session cookie. In production set SESSION_COOKIE_DOMAIN=.themodernpedagogues.com
# so the web app and API on sibling subdomains can share it.
SESSION_COOKIE_NAME=tmp_session
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=12

# Seed passwords are read from env so none are hardcoded. Used only by `pnpm db:seed`
# and refused when NODE_ENV=production.
SEED_PASSWORD=change-me-dev-only

# AI providers (Phase 3). Keys live on the backend only.
# AI_PROVIDER=
# AI_API_KEY=

# Per-IP rate limits (defaults shown; raise only in tests)
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=20
